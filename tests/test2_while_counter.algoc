// Test 2: While Loop and Basic Blocks
// Directly from Algo-C Review 1 Specification (Slide 10)

int countUp(int n) {
    int i = 0;
    while (i < n) {
        i = i + 1;
    }
    return i;
}

int main() {
    print_str("Counting up to 10: ");
    int val = countUp(10);
    print_int(val);
    println();
    return val;
}

